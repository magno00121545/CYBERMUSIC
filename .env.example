# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CYBER MUSIC BACKEND CONFIGURATION
JWT_SECRET="cyber_music_super_secure_jwt_secret_2026_key"
PORT=3000
NODE_ENV="development"

# PIX / PAYMENT GATEWAY CONFIG (Customizable for MercadoPago, Asaas, EFI Bank, OpenPix or Native Webhook Simulator)
